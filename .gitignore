# Python bytecode cache (regenerated automatically, never commit)
__pycache__/
*.pyc

# Secrets and runtime state
.env
.env.*
!.env.example
data/
*.log

# IDE / local tooling
.idea/
.venv/
.claude/

# Real env files of the VM deployment (only the *.example files are tracked)
deploy/*.env

# Documentation is kept outside the repositories
*.md
