# CMT Console on the VM. Copy to deploy/console.env (chmod 600). Never commit the real file.
# No messenger / Slack / Discord / Telegram keys and no Jira key belong here: the bot holds them.

# --- MongoDB on the VM (user cmt_console, see docs/vm-deploy.md) ---
# Our MongoDB container cmt-mongo (bot repo deploy/mongo/init.sh prints these strings with the password).
MONGODB_URI=mongodb://cmt_console:CHANGE_ME@cmt-mongo:27017/?authSource=admin&replicaSet=rs0
MONGODB_DATABASE=reddit_posts
SNAPSHOT_MONGODB_URI=mongodb://cmt_console:CHANGE_ME@cmt-mongo:27017/?authSource=admin&replicaSet=rs0
SNAPSHOT_MONGODB_DATABASE=reddit_snapshots

# --- sessions + addresses ---
# python -c "import secrets; print(secrets.token_hex(32))"
CONSOLE_SECRET_KEY=
CONSOLE_PUBLIC_URL=https://console.example.com
CONSOLE_URL=https://console.example.com/console/
CONSOLE_CANONICAL_HOST=console.example.com
CONSOLE_LEGACY_HOSTS=

# --- sign-in with the company Google account ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONSOLE_GOOGLE_DOMAIN=example.com
# 1 while people move to Google sign-in, then 0 (password sign-in off)
CONSOLE_PASSWORD_LOGIN=1

# --- Jira: no key here, calls go through the bot's internal gateway ---
JIRA_BASE_URL=https://bsdesk.atlassian.net
JIRA_GATEWAY_URL=http://cmt-boost:7001
# same value as JIRA_GATEWAY_TOKEN in the bot's .env; python -c "import secrets; print(secrets.token_hex(32))"
JIRA_GATEWAY_TOKEN=
JIRA_PROJECT_KEY=SO
JIRA_COMMUNICATION_LINK_FIELD=
JIRA_URG_PROJECT_KEY=
JIRA_URG_ISSUE_TYPE=
JIRA_URG_REVIEW_STATUS=
JIRA_URG_UPDATE_RESULT_FIELD=

# --- screenshots (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# --- non-secret settings ---
DISCORD_GUILD_ID=
TELEGRAM_BOT_USERNAME=
VAPID_PUBLIC_KEY=
CLOUD_API_BASE_URL=
FACEBOOK_GROUP_URL=
DEVVIT_APP_ACCOUNTS=
REDDIT_USERNAME=
CONSOLE_THREADS=32
