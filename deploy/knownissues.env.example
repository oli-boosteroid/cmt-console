# Public Known Issues page on the VM (public_app.py). Copy to deploy/knownissues.env (chmod 600).
# Its Mongo user (cmt_public) can only read the published Known Issues / Game List and add suggestions.
MONGODB_URI=mongodb://cmt_public:CHANGE_ME@MONGO_HOST:27017/reddit_posts?authSource=admin
MONGODB_DATABASE=reddit_posts
SNAPSHOT_MONGODB_URI=mongodb://cmt_public:CHANGE_ME@MONGO_HOST:27017/reddit_posts?authSource=admin
SNAPSHOT_MONGODB_DATABASE=reddit_posts
CONSOLE_URL=https://console.example.com/console/

# screenshots shown on the page / uploaded with suggestions
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
